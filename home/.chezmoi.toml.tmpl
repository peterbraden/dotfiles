{{- /*
  Feature toggles (work machine; Go, Node.js, Rust, Python tooling). Asked once by `chezmoi init` and stored in
  ~/.config/chezmoi/chezmoi.toml; machines that already have them aren't asked.
  Defaults come from the known hosts below, so pressing enter (or
  --promptDefaults) does the right thing there. Unattended:
    chezmoi init --promptBool work=true,python=true,...
*/ -}}

{{- $host := .chezmoi.hostname -}}
{{- $isThor := eq $host "thor" -}}
{{- $isVidar := eq $host "Vidar" -}}
{{- $isWork := eq $host "bradenp1-66CPFP" -}}

{{- $work := promptBoolOnce . "work" "work" $isWork -}}
{{- $golang := promptBoolOnce . "golang" "golang" (or $isVidar $isWork) -}}
{{- $nodejs := promptBoolOnce . "nodejs" "nodejs" (or $isThor $isVidar $isWork) -}}
{{- $rust := promptBoolOnce . "rust" "rust" (or $isThor $isVidar $isWork) -}}
{{- $python := promptBoolOnce . "python" "python" (or $isThor $isVidar $isWork) -}}
{{- $workEmail := "" -}}
{{- if $work -}}
{{-   $workEmail = promptStringOnce . "workEmail" "workEmail" "" -}}
{{- end -}}

[data]
    work = {{ $work }}
    golang = {{ $golang }}
    nodejs = {{ $nodejs }}
    rust = {{ $rust }}
    python = {{ $python }}
    workEmail = {{ $workEmail | quote }}

[git]
    autoCommit = true
    autoPush = true
