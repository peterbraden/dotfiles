**/.git

# Hammerspoon is macOS only
{{ if ne .chezmoi.os "darwin" }}
.hammerspoon
{{ end }}

# vdirsyncer only syncs the work calendar
{{ if not .work }}
.config/vdirsyncer
.gitconfig.roche
.gitconfig.work
bin/roche-cal-url
{{ end }}

# The work email comes from chezmoi data; without it there is nothing to write
{{ if not .workEmail }}
.gitconfig.work
{{ end }}

# Work-only scripts (they talk to Roche GitLab)
{{ if not .work }}
bin/absent-days
bin/daily-summary
bin/gl-cat
bin/gl-file-append
bin/gl-ls
bin/my-issues
bin/update-plan
{{ end }}
