#!/bin/bash
# Remove all containers, images and dangling volumes.
# Word splitting of the id lists is intentional.
containers=$(docker ps --all -q)
[ -n "$containers" ] && docker rm --force $containers
images=$(docker images --all -q)
[ -n "$images" ] && docker rmi --force $images
volumes=$(docker volume ls -f dangling=true -q)
[ -n "$volumes" ] && docker volume rm $volumes
exit 0
