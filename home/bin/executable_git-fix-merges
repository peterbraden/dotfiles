#!/usr/bin/env bash
# Open all files with merge conflicts as tabs in vim.
cd "$(git rev-parse --show-toplevel)" || exit 1
files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --name-only --diff-filter=U)
if [ ${#files[@]} -eq 0 ]; then
  echo "No merge conflicts"
  exit 0
fi
vim -p "${files[@]}"
