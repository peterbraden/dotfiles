[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair khal_pair_1]
a = "khal_roche_local"
b = "khal_roche_remote"
collections = null

[storage khal_roche_local]
type = "filesystem"
path = "{{ .chezmoi.homeDir }}/.local/share/khal/roche"
fileext = ".ics"

[storage khal_roche_remote]
type = "http"
# Read from 1Password at sync time, so chezmoi apply never needs 1Password
url.fetch = ["command", "{{ .chezmoi.homeDir }}/bin/roche-cal-url"]
