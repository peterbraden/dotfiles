[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
  pager = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[core]
  editor = vim
  excludesfile = ~/.gitignore
  pager = less -FRSX
  whitespace=-indent-with-non-tab,trailing-space,cr-at-eol

[apply]
  # Fix whitespace errors in patches applied with git apply / git am
  whitespace = fix

[push]
  default = current

[remote "origin"]
  fetch = +refs/pull/*/head:refs/remotes/origin/pr/*
[commit]
	gpgsign = false
[gpg]
	program = gpg
[pull]
	rebase = false

# Machine-local settings (e.g. work identity), not in this repo. Last so it wins.
[include]
    # Work machines only; git ignores a missing include
    path = ~/.gitconfig.roche
[include]
    path = ~/.gitconfig.local
