# Work GitHub orgs use the work account's SSH key (Host github-roche in
# ~/.ssh/config), whatever form the URL was written in.
[url "git@github-roche:roche-innersource/"]
  insteadOf = https://github.com/roche-innersource/
  insteadOf = git@github.com:roche-innersource/
  insteadOf = ssh://git@github.com/roche-innersource/
[url "git@github-roche:Roche/"]
  insteadOf = https://github.com/Roche/
  insteadOf = git@github.com:Roche/
  insteadOf = ssh://git@github.com/Roche/
  insteadOf = https://github.com/roche/
  insteadOf = git@github.com:roche/
