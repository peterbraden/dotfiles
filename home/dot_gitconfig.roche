# Work machines only.

# Work GitHub orgs use the work account's SSH key (Host github-roche in
# ~/.ssh/config), whatever form the URL was written in.
[url "git@github-roche:roche-innersource/"]
  insteadOf = https://github.com/roche-innersource/
  insteadOf = git@github.com:roche-innersource/
  insteadOf = ssh://git@github.com/roche-innersource/
[url "git@github-roche:Roche/"]
  insteadOf = https://github.com/Roche/
  insteadOf = git@github.com:Roche/
  insteadOf = ssh://git@github.com/Roche/
  insteadOf = https://github.com/roche/
  insteadOf = git@github.com:roche/

# Work commit identity (~/.gitconfig.work) for work repos, chosen by remote URL
[includeIf "hasconfig:remote.*.url:git@ssh.code.roche.com:*/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://*@code.roche.com/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://code.roche.com/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:Roche/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/Roche/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:roche-innersource/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/roche-innersource/**"]
  path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github-roche:**"]
  path = ~/.gitconfig.work
