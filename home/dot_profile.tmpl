# nmvim:fdm=marker
#
# .profile is executed by login shells as the login shell $SHELL
# But NB. it's not executed by zsh (we need to source it manually in .zprofile)
# Because of this we stick to /bin/sh syntax
#
# .profile is a good place for environment variables
# For bash we source .bashrc so login shells get the interactive setup too.

export DOTPATH=~/.local/share/chezmoi

if [ -f ~/.profile.local ]; then
  . ~/.profile.local
fi

export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

export EDITOR=vim
export GIT_EDITOR=vim
export VISUAL=vim

export GPG_TTY=$(tty)

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
# Highlight section titles in manual pages.
export LESS_TERMCAP_md="$(printf '\033[1;33m')" # bold yellow

# PATH Manipulation ----
# Never add duplicates, so nested login shells (tmux, su -) don't keep
# growing PATH.

# Remove every occurrence of $1 from PATH
path_remove() {
  PATH=":$PATH:"
  while :; do
    case "$PATH" in
      *":$1:"*) PATH="${PATH%%:"$1":*}:${PATH#*:"$1":}" ;;
      *) break ;;
    esac
  done
  PATH="${PATH#:}"
  PATH="${PATH%:}"
}
# Move $1 to the front, so it wins even if PATH already had it (path_helper
# puts /usr/bin first in nested macOS login shells)
path_prepend() {
  path_remove "$1"
  PATH="$1:$PATH"
}
path_append() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

path_append /opt/local/bin
path_append /opt/local/sbin
path_append /usr/local/bin
path_append /usr/local/sbin

path_prepend /opt/homebrew/bin  # Homebrew

{{ if .golang }}
path_append /usr/local/go/bin   # Add golang
{{ end }}
{{ if .nodejs }}

path_prepend "$HOME/repos/utils/bin"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
{{ end }}
{{ if .python }}
# Pyenv
if command -v pyenv > /dev/null 2>&1; then
  # pyenv init adds the shims to PATH itself
  eval "$(pyenv init -)"
fi
{{ end }}

{{ if .rust }}
# Add cargo
if test -e "$HOME/.cargo/env"; then
  # cargo's env adds ~/.cargo/bin to PATH if it isn't there already
  . "$HOME/.cargo/env"
elif test -d "$HOME/.cargo/bin"; then
  # apt's rustup doesn't create ~/.cargo/env
  path_prepend "$HOME/.cargo/bin"
fi
{{ end }}

export PATH
unset -f path_remove path_prepend path_append

# -- SSH Agent --
if [ -z "$SSH_AUTH_SOCK" -a -x "/usr/bin/ssh-agent" ]; then
  # Only run ssh agent if not already in a forwarded session
  # Keys are added on first use (AddKeysToAgent in ~/.ssh/config)
	eval `ssh-agent -s`
	trap "kill $SSH_AGENT_PID" 0
else
  # We are in a forwarded session.
  # If we are starting a shell in tmux, then we should refresh the socket
  # This only works for new shells.
  if [ -n "$TMUX" ]; then
    export $(tmux show-environment | grep "^SSH_AUTH_SOCK")
  fi
fi

# bash login shells don't read .bashrc, so pull it in here.
# zsh reads .zshrc itself after .zprofile, so it must not be sourced here.
if [ -n "$BASH_VERSION" ]; then
  . ~/.bashrc
fi

