# vim:foldmethod=marker:fmr=(((,)))


emulate sh
# Source aliases
. ~/.alias
emulate zsh

export GIT="$(which git)"

############ Prompt ######################
autoload colors && colors

bindkey -e

git_branch() {
  echo $($GIT symbolic-ref HEAD 2>/dev/null | awk -F/ {'print $NF'})
}

git_dirty() {
  # Ignore the repo's core.fsmonitor: it can be a command, and this runs on cd
  st=$($GIT -c core.fsmonitor=false status --porcelain --ignore-submodules=dirty 2>/dev/null | tail -n 1)
  if [[ $st == "" ]]
  then
      echo "%{$fg[green]%}$(git_prompt_info)%{$reset_color%}"
  else
    if [[ $st =~ ^nothing ]]
    then
      echo "%{$fg[green]%}$(git_prompt_info)%{$reset_color%}"
    else
      echo "%{$fg[red]%}$(git_prompt_info)%{$reset_color%}"
    fi
  fi
}

git_prompt_info () {
 ref=$($GIT symbolic-ref HEAD 2>/dev/null) || return
# echo "(%{\e[0;33m%}${ref#refs/heads/}%{\e[0m%})"
 echo "${ref#refs/heads/}"
}


directory_name(){
  echo "%{$fg[green]%}%~%{${reset_color%}%}"
}

# Set the window title to the running command.
# preexec gets the command line as typed ($1) and fully expanded ($3).
function preexec() {
  # escape '%' chars in $1, make nonprintables visible
  a=${(V)1//\%/\%\%}

  # Truncate command, and join lines.
  a=$(print -Pn "%40>...>$a" | tr -d "\n")

  case $TERM in
  screen*|tmux*)
    print -Pn "\ek$a\e\\" # screen/tmux window title
    ;;
  xterm*|rxvt*)
    print -Pn "\e]2;$a\a" # plain xterm title
    ;;
  esac
}

function precmd() {
  export PROMPT="$(directory_name):$(git_dirty)$ "
}

# matches case insensitive for lowercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# pasting with tabs doesn't perform completion
zstyle ':completion:*' insert-tab pending

################### History #############
HISTFILE=$HOME/.zsh_history
HISTSIZE=2000
SAVEHIST=2000
setopt   appendhistory
setopt   incappendhistory
setopt histignorealldups
setopt EXTENDED_HISTORY
setopt share_history

# Atuin is a tool for interacting with history
if [ -x "$(command -v atuin)" ]; then
  eval "$(atuin init zsh)"
fi


# ZSH Completions
autoload -Uz compinit
compinit

# Plugins
source ~/.config/zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

{{ if .work }}
{{-  template "work_profile.tmpl" . -}}
{{ end }}
